rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Função para verificar se é admin
    function isAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Eventos e Capas: leitura pública, upload apenas admin
    match /eventos/{eventoId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /event-covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Galeria: leitura pública, upload apenas admin
    match /galeria/{albumId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users: leitura pública, upload apenas o próprio usuário ou admin
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}
