rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário é admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Função para verificar se é o próprio usuário
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users: leitura própria ou admin, criação livre (cadastro), update/delete apenas admin
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    // Eventos: leitura pública, escrita apenas admin
    match /events/{eventoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Posts: leitura pública, escrita apenas admin
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Vídeos: leitura pública, escrita apenas admin
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Galeria: leitura pública, escrita apenas admin
    match /galeria_albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /galeria_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Serviços: leitura pública, escrita apenas admin
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Eventos Futuros: leitura pública, escrita apenas admin
    match /future_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Trajetória: leitura pública, escrita apenas admin
    match /trajectory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Depoimentos: leitura pública, escrita apenas admin
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Mail: apenas admin
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }
    
    // Contatos do Site: qualquer um pode criar, apenas admin lê
    match /mensagens_contato/{contatoId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Analytics: qualquer um pode criar, apenas admin lê ou modifica
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
